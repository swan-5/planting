rules_version = '2';

// Every synced collection lives under users/{uid}/... (see
// Core/Sync/FirestoreSyncEngine.swift) — one rule covers all of them since
// the uid segment of the path is itself the access check.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != nil && request.auth.uid == uid;
    }
  }
}
